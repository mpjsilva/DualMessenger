{
  "name": "dual-messenger-app",
  "productName": "Dual Messenger",
  "version": "0.1.21",
  "description": "Vários WhatsApp Web e Telegram Web em abas isoladas, com transcrição local de mensagens de voz e userscripts.",
  "main": "src/main.js",
  "author": "mpjsilva",
  "homepage": "https://github.com/mpjsilva/DualMessenger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpjsilva/DualMessenger.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --linux AppImage deb rpm --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:win:docker": "docker run --rm -e ELECTRON_CACHE=/work/.cache/electron -e ELECTRON_BUILDER_CACHE=/work/.cache/electron-builder -v \"$PWD\":/work -w /work electronuserland/builder:wine bash -c \"npx electron-builder --win nsis --x64 --publish never; chown -R $(id -u):$(id -g) /work/dist /work/.cache; rm -rf /work/.cache\"",
    "postdist": "node scripts/limpar-dist.js",
    "postdist:win": "node scripts/limpar-dist.js",
    "postdist:win:docker": "node scripts/limpar-dist.js",
    "sha256": "node scripts/sha256.js"
  },
  "build": {
    "appId": "local.dualmessenger.app",
    "artifactName": "DualMessenger-${version}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network;InstantMessaging",
      "icon": "assets/icone.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "local.dualmessenger.app"
        }
      },
      "maintainer": "mpjsilva <56980262+mpjsilva@users.noreply.github.com>"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DualMessenger-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Dual Messenger"
    },
    "directories": {
      "output": "dist/${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mpjsilva",
        "repo": "DualMessenger"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
