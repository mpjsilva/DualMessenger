{
  "name": "dual-messenger-app",
  "productName": "Dual Messenger",
  "version": "0.1.13",
  "description": "Vários WhatsApp Web e Telegram Web em abas isoladas, com transcrição local de mensagens de voz e userscripts.",
  "main": "src/main.js",
  "author": "mpjsilva",
  "homepage": "https://github.com/mpjsilva/DualMessenger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpjsilva/DualMessenger.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis --x64 --config.directories.output=dist/win"
  },
  "build": {
    "appId": "local.dualmessenger.app",
    "artifactName": "DualMessenger-${version}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network;InstantMessaging",
      "icon": "assets/icone.png"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DualMessenger-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Dual Messenger"
    }
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.1"
  }
}
